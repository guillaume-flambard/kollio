POSTGRES_PASSWORD=
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://kollio:REPLACE_ME@localhost:54329/kollio
REDIS_URL=redis://localhost:63799/0
NUXT_PUBLIC_AUTH_ENABLED=false
NUXT_LOGTO_ENDPOINT=https://kollio-auth.memolabs.dev/
NUXT_LOGTO_APP_ID=zfbse6gg3ilyvl8194xd6
NUXT_LOGTO_APP_SECRET=
NUXT_LOGTO_COOKIE_ENCRYPTION_KEY=
NUXT_LOGTO_CUSTOM_REDIRECT_BASE_URL=
LOGTO_ISSUER=https://kollio-auth.memolabs.dev/oidc
LOGTO_JWKS_URL=https://kollio-auth.memolabs.dev/oidc/jwks
LOGTO_AUDIENCE=https://kollio.memolabs.dev/api
LLM_BASE_URL=http://localhost:4000/v1
LLM_API_KEY=
# Commodity model for cheap work (extraction, classification, embeddings). Defaults below.
LLM_MODEL=kollio-default
# Premium model for the reasoning a member reads (challenge, contradiction, analysis, learning).
# Leave empty to reuse LLM_MODEL (local dev and CI run the whole loop without premium credentials).
LLM_MODEL_VISIBLE=
BAI_API_KEY=
OPENAI_API_KEY=
# Embedding space (defaults are the local space; nothing to set for local dev):
# EMBEDDING_MODEL=kollio-embedding-local
# EMBEDDING_SOURCE_MODEL=intfloat/multilingual-e5-small
# EMBEDDING_DIMENSIONS=384
# To select the OpenAI space instead, set all of these (needs a valid key):
# EMBEDDING_MODEL=kollio-embedding
# EMBEDDING_SOURCE_MODEL=text-embedding-3-large
# EMBEDDING_DIMENSIONS=1536
# EMBEDDING_QUERY_PREFIX=
# EMBEDDING_PASSAGE_PREFIX=
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGCHAIN_TRACING_V2=false
DEEPEVAL_TELEMETRY_OPT_OUT=YES

# Generate a random master key; application traffic uses a scoped virtual key.
LITELLM_MASTER_KEY=
BAI_API_KEY=
OPENAI_API_KEY=

# Langfuse v4 OTLP: append x-langfuse-ingestion-version=4 to the encoded headers.
# Keep the API key encoded and outside this file.
