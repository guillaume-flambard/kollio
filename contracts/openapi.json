              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "AnalysisEvidence": {
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "title": "Id"
          },
          "url": {
            "type": "string",
            "minLength": 1,
            "title": "Url"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "title": "Text"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "url",
          "text"
        ],
        "title": "AnalysisEvidence"
      },
      "AnalysisWorkflowResponse": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "idea_id": {
            "type": "string",
            "format": "uuid",
            "title": "Idea Id"
          },
          "source_iteration_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Iteration Id"
          },
          "locale": {
            "type": "string",
            "enum": [
              "fr",
              "en"
            ],
            "title": "Locale"
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "running",
              "awaiting_review",
              "review_queued",
              "completed",
              "rejected",
              "failed"
            ],
            "title": "Status"
          },
          "current_step": {
            "type": "string",
            "title": "Current Step"
          },
          "draft_result": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ConstraintAnalysisResult"
              },
              {
                "type": "null"
              }
            ]
          },
          "result": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ConstraintAnalysisResult"
              },
              {
                "type": "null"
              }
            ]
          },
          "error_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Code"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          },
          "finished_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Finished At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "idea_id",
          "source_iteration_id",
          "locale",
          "status",
          "current_step",
          "draft_result",
          "error_code",
          "created_at",
          "updated_at",
          "finished_at"
        ],
        "title": "AnalysisWorkflowResponse"
      },
      "CollaboratorResponse": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "handle": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Handle"
          },
          "display_name": {
            "type": "string",
            "title": "Display Name"
          },
          "role": {
            "type": "string",
            "title": "Role"
          },
          "roles": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Roles"
          },
          "bio": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Bio"
          },
          "avatar_key": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Avatar Key"
          }
        },
        "type": "object",
        "required": [
          "id",
          "display_name",
          "role",
          "roles"
        ],
        "title": "CollaboratorResponse"
      },
      "ConstraintAnalysisResult": {
        "properties": {
          "overall_score": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Overall Score"
          },
          "verdict": {
            "type": "string",
            "enum": [
              "viable",
              "conditional",
              "not_viable",
              "unknown"
            ],
            "title": "Verdict"
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "title": "Summary"
          },
          "factors": {
            "items": {
              "$ref": "#/components/schemas/ConstraintFactor"
            },
            "type": "array",
            "maxItems": 5,
            "minItems": 5,
            "title": "Factors"
          },
          "locale": {
            "type": "string",
            "enum": [
              "fr",
              "en"
            ],
            "title": "Locale"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "overall_score",
          "verdict",
          "summary",
          "factors",
          "locale"
        ],
        "title": "ConstraintAnalysisResult"
      },
      "ConstraintFactor": {
        "properties": {
          "name": {
            "type": "string",
            "enum": [
              "competition",
              "build_cost",
              "time_to_market",
              "defensibility",
              "acquisition"
            ],
            "title": "Name"
          },
          "score": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Score"
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "title": "Summary"
          },
          "source_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Source Ids"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "score",
          "summary",
          "source_ids"
        ],
        "title": "ConstraintFactor"
      },
      "CreateIterationRequest": {
        "properties": {
          "message": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Message"
          },
          "lang": {
            "type": "string",
            "enum": [
              "fr",
              "en"
            ],
            "title": "Lang"
          },
          "snapshot": {
            "$ref": "#/components/schemas/IdeaSnapshot"
          },
          "branch": {
            "type": "string",
            "pattern": "^(main|proposal/[a-z0-9][a-z0-9._-]{0,47})$",
            "title": "Branch",
            "default": "main"
          },
          "expected_parent_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expected Parent Id"
          }
        },
        "type": "object",
        "required": [
          "message",
          "lang",
          "snapshot"
        ],
        "title": "CreateIterationRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Health": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "Health"
      },
      "IdeaPageResponse": {
        "properties": {
